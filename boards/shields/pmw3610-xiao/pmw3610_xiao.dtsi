#include <physical_layouts.dtsi>
#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>

/ {

    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;

        /* Layer 0 (default): 0 - no processor needed */

        /* Layer 1: 90 CW - swap XY then invert X */
        rot90_layer {
            layers = <1>;
            input-processors = <&zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_X_INVERT)>;
        };

        /* Layer 2: 180 - invert both X and Y */
        rot180_layer {
            layers = <2>;
            input-processors = <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>;
        };

        /* Layer 3: 270 CW - swap XY then invert Y */
        rot270_layer {
            layers = <3>;
            input-processors = <&zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_Y_INVERT)>;
        };
    };

    matrix_transform0: matrix_transform0 {
        compatible = "zmk,matrix-transform";
        rows = <1>;
        columns = <8>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7)
        >;
    };

    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios
            = <&gpio0 2  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 16 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 28 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 3  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 4  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 29 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 5  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            ;
    };

    physical_layout0: physical_layout0 {
        compatible = "zmk,physical-layout";
        display-name = "Default";
        kscan = <&kscan0>;
        transform = <&matrix_transform0>;
        keys
            = <&key_physical_attrs 120  60  90  20 0 0 0>  /* Key 0: 0.02 (Top Center) */
            , <&key_physical_attrs 120  60  90 100 0 0 0>  /* Key 1: 0.16 (Upper Center) */
            , <&key_physical_attrs 110 160  20 180 0 0 0>  /* Key 2: 0.28 (Upper Left) */
            , <&key_physical_attrs 110 160 170 180 0 0 0>  /* Key 3: 0.03 (Upper Right) */
            , <&key_physical_attrs 110 160  20 520 0 0 0>  /* Key 4: 0.04 (Lower Left) */
            , <&key_physical_attrs 110 160 170 520 0 0 0>  /* Key 5: 0.29 (Lower Right) */
            , <&key_physical_attrs 110  60  20 700 0 0 0>  /* Key 6: 1.11 (Bottom Left) */
            , <&key_physical_attrs 110  60 170 700 0 0 0>  /* Key 7: 0.05 (Bottom Right) */
            ;
    };



    encoder: encoder {
        compatible = "alps,ec11";
        a-gpios = <&gpio1 0  (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio1 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <48>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder>;
        status = "okay";
        triggers-per-rotation = <24>;
    };
};
