/* Trackball 4-direction rotation: 0/90/180/270 via Button 1 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 20
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <100>;
        };
    };


    keymap {
        compatible = "zmk,keymap";

        default_layer {
            /* Layer 0: Hướng 0° (bình thường) */
            bindings = <
                &to 1    /* Nút 1: → chuyển sang 90° */
                &kp B    /* Nút 2 */
                &kp C    /* Nút 3 */
                &kp D    /* Nút 4 */
                &kp E    /* Nút 5 */
                &kp F    /* Nút 6 */
                &kp G    /* Nút 7 */
                &kp H    /* Nút 8 */
            >;
            sensor-bindings = <&scroll_encoder>;
        };

        m1_layer {
            /* Layer 1: Hướng 90° CW */
            bindings = <
                &to 2    /* Nút 1: → chuyển sang 180° */
                &kp B    /* Nút 2 */
                &kp C    /* Nút 3 */
                &kp D    /* Nút 4 */
                &kp E    /* Nút 5 */
                &kp F    /* Nút 6 */
                &kp G    /* Nút 7 */
                &kp H    /* Nút 8 */
            >;
            sensor-bindings = <&scroll_encoder>;
        };

        m2_layer {
            /* Layer 2: Hướng 180° */
            bindings = <
                &to 3    /* Nút 1: → chuyển sang 270° */
                &kp B    /* Nút 2 */
                &kp C    /* Nút 3 */
                &kp D    /* Nút 4 */
                &kp E    /* Nút 5 */
                &kp F    /* Nút 6 */
                &kp G    /* Nút 7 */
                &kp H    /* Nút 8 */
            >;
            sensor-bindings = <&scroll_encoder>;
        };

        m3_layer {
            /* Layer 3: Hướng 270° CW */
            bindings = <
                &to 0    /* Nút 1: → quay về 0° */
                &kp B    /* Nút 2 */
                &kp C    /* Nút 3 */
                &kp D    /* Nút 4 */
                &kp E    /* Nút 5 */
                &kp F    /* Nút 6 */
                &kp G    /* Nút 7 */
                &kp H    /* Nút 8 */
            >;
            sensor-bindings = <&scroll_encoder>;
        };
    };
};
